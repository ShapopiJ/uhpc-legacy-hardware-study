#!/bin/bash
#PBS -N numa_locality
#PBS -q stampede
#PBS -l select=1:ncpus=16
#PBS -l walltime=00:20:00
#PBS -j oe

# Isolated NUMA-penalty experiment: single-thread STREAM-Triad bandwidth,
# comparing memory bound to the *same* socket as the running thread (local)
# against memory bound to the *other* socket (remote). CPU is pinned to
# core 0 (NUMA node 0) in both cases via numactl --physcpubind; only the
# memory placement (--membind) changes. Node has 2 sockets / 8 cores each
# (Xeon E5-2680): node 0 = cpus 0-7, node 1 = cpus 8-15.

cd "$PBS_O_WORKDIR"
BIN=../scripts/stream_triad
N=200000000
ITERS=5
REPS=20
OUT="numa_locality_$(date +%Y%m%d_%H%M%S).csv"

echo "host,mode,rep,bandwidth_GBps" > "$OUT"

for rep in $(seq 1 $REPS); do
    bw=$(OMP_NUM_THREADS=1 numactl --physcpubind=0 --membind=0 "$BIN" $N $ITERS)
    echo "$(hostname),local,$rep,$bw" >> "$OUT"
done

for rep in $(seq 1 $REPS); do
    bw=$(OMP_NUM_THREADS=1 numactl --physcpubind=0 --membind=1 "$BIN" $N $ITERS)
    echo "$(hostname),remote,$rep,$bw" >> "$OUT"
done

echo "wrote $OUT"
